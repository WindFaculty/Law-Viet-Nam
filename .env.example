# Export these variables in your shell when overriding local defaults.
# Never commit .env and never put a real key in this example file.

# --- Local PostgreSQL 18 + pgvector ---
DB_URL=jdbc:postgresql://localhost:5432/lawrag
DB_USERNAME=lawrag
DB_PASSWORD=lawrag_local_dev

# --- Gemini (leave empty unless app.gemini.enabled is true) ---
GOOGLE_API_KEY=

# --- Feature flags ---
GEMINI_ENABLED=false
WEBSEARCH_ENABLED=false
INGESTION_ENABLED=false

# --- Cookies / server ---
SECURE_COOKIES=false
SERVER_PORT=8080
